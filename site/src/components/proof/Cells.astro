---
interface Props {
  cols?: 1 | 2 | 3 | 4;
}

const { cols = 1 } = Astro.props;
---

<div class="cells" data-cols={cols}>
  <slot />
</div>

<style>
  .cells {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: 1px;
    border-top: 1px solid var(--line);
    background: var(--line);
  }
  .cells[data-cols="1"] { --cols: 1; }
  .cells[data-cols="2"] { --cols: 2; }
  .cells[data-cols="3"] { --cols: 3; }
  .cells[data-cols="4"] { --cols: 4; }
  .cells > :global(*) {
    min-width: 0;
    padding: clamp(24px, 4vw, 40px);
    background: var(--surface);
  }
  @media (max-width: 900px) {
    .cells[data-cols="2"], .cells[data-cols="3"] { --cols: 1; }
    .cells[data-cols="4"] { --cols: 2; }
  }
  @media (max-width: 560px) {
    .cells[data-cols="4"] { --cols: 1; }
  }
</style>
