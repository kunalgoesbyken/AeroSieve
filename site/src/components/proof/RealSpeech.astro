---
import { LINKS } from "../../data/site.js";
import Section from "../Section.astro";
import Cells from "./Cells.astro";
import Head from "./Head.astro";

const ROWS = [
  { label: "WER on utterances it accepts", whisper: { value: "55.7%" }, mms: { value: "52.0%" } },
  { label: "WER on utterances it rejects", whisper: { value: "64.6%" }, mms: { value: "60.6%" } },
  { label: "Gap, 95% CI", whisper: { value: "+8.9", ci: "+2.2 to +16.9" }, mms: { value: "+8.6", ci: "+5.5 to +11.6" }, key: true },
  { label: "Gap within 8 kHz audio only", whisper: { value: "+7.6", ci: "+1.1 to +15.3" }, mms: { value: "+6.6", ci: "+3.5 to +9.8" }, key: true },
];

const FINDINGS = [
  {
    label: "What it showed",
    title: "The signal comes from the tonality check",
    text: "The 142 utterances rejected as tonal are the hardest group: 69.3% WER for Whisper and 66.7% for MMS. Rejected audio is harder for both models, and the gap holds within narrowband audio, so it is not only that phone audio is harder.",
  },
  {
    label: "What it showed",
    title: "The SNR check did not predict errors",
    text: "All 58 low_snr rejections are wideband, half with a music bed, and they are easier than average: 52.6% and 44.4% WER. Within each channel, WADA-SNR barely correlates with per-utterance WER (Spearman between −0.12 and +0.01).",
  },
  {
    label: "What it does not prove",
    title: "No model has been trained on the kept audio",
    text: "AeroSieve rejects 8.3% of utterances that annotators marked inaudible and 6.1% of unmarked ones, so it barely tracks human labels. Whether training on the kept audio gives a better model is planned, not done.",
  },
];
---

<Section id="real-speech" cross>
  <Head label="Real phone speech" title="Do the utterances it rejects really transcribe worse?">
    SieveBench only shows that AeroSieve catches the damage we injected. This experiment asks about real audio, with no model trained.
  </Head>
  <Cells cols={2}>
    <div class="method">
      <h3 class="label">Method</h3>
      <p>
        Gram Vaani Hindi Dev and Eval (OpenSLR 118): 2,917 utterances, 7.8 h of spontaneous speech recorded over phones, 60% of it at 8 kHz. Transcripts were verified twice by humans, so a high error rate reflects the audio and not a bad label.
      </p>
      <p>
        AeroSieve scored each utterance whole with the default policy. Whisper-large-v3 and MMS-1B then transcribed all of them with greedy decoding and no fine-tuning, and word error rate was compared between accepted and rejected utterances.
      </p>
      <p class="fine">Two utterances over 30 s are excluded. 95% confidence intervals come from 10,000 bootstrap resamples. 2,714 utterances are accepted and 201 rejected.</p>
    </div>
    <div class="results">
      <div class="scroll">
        <table>
          <thead>
            <tr><th></th><th>Whisper-large-v3</th><th>MMS-1B</th></tr>
          </thead>
          <tbody>
            {ROWS.map(({ label, whisper, mms, key }) => (
              <tr class:list={{ key }}>
                <th scope="row">{label}</th>
                {[whisper, mms].map(({ value, ci }) => (
                  <td>
                    <span class="value">{value}</span>
                    {ci && <span class="ci">{ci}</span>}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="fine">Word error rate, corpus-level. Gaps are in percentage points, rejected minus accepted.</p>
    </div>
  </Cells>
  <Cells cols={3}>
    {FINDINGS.map(({ label, title, text }) => (
      <div class="finding">
        <p class="label">{label}</p>
        <h3>{title}</h3>
        <p>{text}</p>
      </div>
    ))}
  </Cells>
  <Cells>
    <div class="foot">
      <p>Scripts, full per-reason, per-channel and SNR-quintile tables, and the training plan are in the experiment folder.</p>
      <a class="text-link" href={LINKS.experiment}>experiments/asr-hi<span class="arrow">→</span></a>
    </div>
  </Cells>
</Section>

<style>
  .method, .finding { display: grid; align-content: start; gap: 16px; }
  .method p:not(.fine), .finding p:not(.label) { color: var(--ink-soft); }
  .finding h3 { font-size: 20px; line-height: 1.3; }
  .results { display: grid; align-content: start; gap: 16px; }
  .scroll { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; }
  th, td { padding: 16px 12px; border-bottom: 1px solid var(--line); text-align: right; vertical-align: top; }
  thead th { padding-top: 0; font: 500 12px/16px var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  tbody th { padding-left: 0; text-align: left; font-weight: 400; color: var(--ink-soft); }
  td { padding-right: 0; }
  .value { display: block; font: 400 20px/28px var(--mono); }
  .ci { display: block; font: 400 12px/18px var(--mono); color: var(--muted); }
  .key td .value { color: var(--brand); }
  .key th { color: var(--ink); }
  .foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 32px; }
  .foot p { color: var(--ink-soft); max-width: 64ch; }
</style>
