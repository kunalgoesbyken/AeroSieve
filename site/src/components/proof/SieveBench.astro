---
import Section from "../Section.astro";
import Cells from "./Cells.astro";
import Head from "./Head.astro";
import { count, keptShare, REPORTS, rightReasonShare, TOTALS } from "../../data/sievebench.js";

const DEFECTS = [
  "White, pink and babble noise at six levels",
  "Overdrive",
  "A phone line",
  "Near-silence",
  "Tones and hum",
];

const HEADERS = ["Language", "Audio", "Untouched audio kept", "Over a phone line", "Defects caught", "Named the right defect"];

const percent = (value: number) => `${Math.round(value * 100)}%`;
const precisePercent = (value: number) => `${(value * 100).toFixed(1)}%`;

const ROWS = REPORTS.map((report) => ({
  corpus: report.corpus,
  source: report.source,
  minutes: Math.round(report.hours * 60),
  bars: [keptShare(report, "clean"), keptShare(report, "phone_line")],
  recall: precisePercent(report.overall.recall),
  rightReason: precisePercent(rightReasonShare(report)),
}));

const ESTIMATES = REPORTS.map(({ corpus, snr_estimates }) => ({ corpus, snr_estimates }));

const NOTES = [
  "WADA-SNR lands within about 1.3 dB of the injected level for white and pink noise from 0 to 20 dB. Babble reads up to 2.7 dB cleaner than it is, because it looks like speech. Above 20 dB the curves flatten at the recordings' own noise floor.",
  "FLEURS volunteers recorded on their own devices, so some untouched clips really are noisy. Most of what Hindi, Tamil and Bengali lose is already under the 10 dB floor.",
  `${count(TOTALS.unsegmented)} damaged recordings never became a clip and are counted neither way.`,
];
---

<div class="bench" data-results={JSON.stringify(ESTIMATES)}>
  <Section id="sievebench" cross>
    <Head label="SieveBench" title="We damaged clean speech on purpose">
      SieveBench injects known defects into real recordings and runs every damaged copy through the same code as the CLI. If AeroSieve works, each one is rejected and the untouched audio is kept.
    </Head>
    <Cells cols={2}>
      <div class="total">
        <p class="label">Rejected when they should be</p>
        <p class="metric is-hero">{count(TOTALS.caught)}<span class="of"> of {count(TOTALS.expected)}</span></p>
        <p>
          Damaged clips that should be rejected were, from {count(TOTALS.clips)} test copies of {count(TOTALS.recordings)} recordings in {REPORTS.length} languages. All but {TOTALS.misnamed} named the injected defect.
        </p>
      </div>
      <div class="defects">
        <p class="label">What gets injected</p>
        <ul>
          {DEFECTS.map((defect) => <li>{defect}</li>)}
        </ul>
      </div>
    </Cells>
    <Cells>
      <div class="table">
        <div class="scroll">
          <table>
            <thead>
              <tr>{HEADERS.map((header) => <th>{header}</th>)}</tr>
            </thead>
            <tbody>
              {ROWS.map(({ corpus, source, minutes, bars, recall, rightReason }) => (
                <tr>
                  <td><strong>{corpus}</strong><span class="source">{source}</span></td>
                  <td>{minutes} min</td>
                  {bars.map((value) => <td><span class="bar" style={`--v: ${value.toFixed(3)}`}></span>{percent(value)}</td>)}
                  <td class="strong">{recall}</td>
                  <td>{rightReason}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </Cells>
    <Cells cols={2}>
      <div class="chart">
        <h3>How close is the noise estimate?</h3>
        <p class="fine">Median WADA-SNR reading against the noise level actually injected. Hover a point for the spread.</p>
        <div class="switch" role="group" aria-label="Corpus">
          {REPORTS.map(({ corpus }, index) => (
            <button type="button" class="chip" data-snr-corpus={index} aria-pressed={String(index === 0)}>{corpus}</button>
          ))}
        </div>
        <figure class="snr-chart" data-snr>
          <div data-chart></div>
          <p class="chart-tip" data-chart-tip hidden></p>
        </figure>
      </div>
      <div class="notes">
        <p class="label">Reading the results</p>
        {NOTES.map((note) => <p>{note}</p>)}
      </div>
    </Cells>
  </Section>
</div>

<style>
  .total, .defects, .chart, .notes { display: grid; align-content: start; gap: 16px; }
  .total p:not(.label):not(.metric), .notes p:not(.label) { color: var(--ink-soft); }
  .of { font-size: 0.5em; letter-spacing: -0.03em; color: var(--muted); }
  .defects ul { display: grid; padding: 0; margin: 0; list-style: none; }
  .defects li { padding: 14px 0; border-bottom: 1px solid var(--line); color: var(--ink-soft); }
  .defects li:first-child { border-top: 1px solid var(--line); }
  .chart h3 { font-size: 20px; line-height: 1.3; }
  .scroll { overflow-x: auto; }
  table { width: 100%; min-width: 760px; border-collapse: collapse; }
  .switch { display: flex; flex-wrap: wrap; gap: 8px; }
  .snr-chart { position: relative; margin: 8px 0 0; }
</style>

<style is:global>
  .bench th {
    padding: 0 16px 14px 0;
    border-bottom: 1px solid var(--line-strong);
    text-align: left;
    font: 500 12px/16px var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }
  .bench td {
    padding: 16px 16px 16px 0;
    border-bottom: 1px solid var(--line);
    font: 400 14px/20px var(--mono);
    white-space: nowrap;
  }
  .bench tbody tr:last-child td { border-bottom: 0; }
  .bench td:first-child { font-family: var(--sans); font-size: 16px; }
  .bench td strong { display: block; font-weight: 400; }
  .bench td .source { display: block; font: 400 13px/18px var(--sans); color: var(--muted); }
  .bench td.strong { color: var(--brand); }
  .bench td .bar {
    display: inline-block;
    width: calc(var(--v) * 64px);
    height: 8px;
    margin-right: 10px;
    background: var(--accent);
    vertical-align: middle;
  }

  .bench .chip {
    min-height: 32px;
    padding: 0 12px;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    font: 500 12px/16px var(--mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.2s var(--ease), color 0.2s var(--ease), border-color 0.2s var(--ease);
  }
  .bench .chip:hover { border-color: var(--ink); }
  .bench .chip[aria-pressed="true"] { border-color: var(--ink); background: var(--ink); color: var(--surface); }

  .bench .snr-chart svg { width: 100%; height: auto; overflow: visible; font: 11px var(--mono); }
  .bench .snr-chart .axes text { fill: var(--muted); }
  .bench .snr-chart .axis-title { font-family: var(--sans); font-size: 12px; }
  .bench .snr-chart .grid { stroke: var(--line); stroke-width: 1; }
  .bench .snr-chart .identity { stroke: var(--ink-soft); stroke-width: 1; stroke-dasharray: 4 4; opacity: 0.5; }
  .bench .snr-chart .identity-label { fill: var(--muted); font-family: var(--sans); font-size: 11px; }
  .bench .snr-chart .series-line { fill: none; stroke: var(--color); stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; stroke-dasharray: 1; animation: bench-draw 1.3s var(--ease) both; }
  .bench .snr-chart .series-dot { fill: var(--color); stroke: var(--surface); stroke-width: 2; animation: bench-settle 0.5s var(--ease) 0.8s both; transform-box: fill-box; transform-origin: center; }
  .bench .snr-chart .series-label { fill: var(--ink-soft); font: 500 12px var(--sans); }
  .bench .snr-chart .hit { fill: transparent; cursor: crosshair; outline: none; }
  .bench .snr-chart .hit:focus-visible { stroke: var(--ink); stroke-width: 1.5; }
  .bench .chart-tip {
    position: absolute;
    z-index: 2;
    max-width: 260px;
    margin: 0;
    padding: 8px 10px;
    background: var(--ink);
    color: var(--surface);
    font: 400 12px/1.4 var(--mono);
    transform: translate(-50%, calc(-100% - 12px));
    pointer-events: none;
  }
  @keyframes bench-draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes bench-settle { from { opacity: 0; transform: scale(0.4); } }

  @media (max-width: 560px) {
    .bench .snr-chart svg { font-size: 17px; }
    .bench .snr-chart .axis-title, .bench .snr-chart .identity-label { font-size: 17px; }
    .bench .snr-chart .series-label { font-size: 18px; }
    .bench .chip { min-height: 44px; }
  }
</style>
