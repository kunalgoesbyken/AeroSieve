---
import "../../styles/verdicts.css";
import Section from "../Section.astro";
import hero from "../../../public/data/hero.json";

const SAMPLES = [
  { file: "mixed.ogg", label: "Mixed" },
  { file: "clean.ogg", label: "Clean" },
  { file: "noisy.ogg", label: "Noisy" },
  { file: "clipped.ogg", label: "Clipped" },
  { file: "dial-tone.ogg", label: "Dial tone" },
];

const COLUMNS = ["Start", "Length", "SNR dB", "dBFS", "Clip", "Flatness", "Verdict", "Why"];
---

<Section id="demo" tone="canvas">
  <div class="head">
    <p class="label">Live demo</p>
    <h2 class="title">Try it on your own audio</h2>
    <p class="lede">The same Rust code as the command-line tool, compiled to WebAssembly. Nothing is uploaded.</p>
  </div>
</Section>

<Section tone="surface" cross>
  <div class="demo" data-demo={JSON.stringify(hero)}>
    <div class="toolbar">
      <span class="label">Sample</span>
      <div class="chips" role="group" aria-label="Sample recordings">
        {SAMPLES.map(({ file, label }) => (
          <button type="button" class="chip" data-sample={file} aria-pressed={String(file === hero.sample)}>{label}</button>
        ))}
      </div>
      <label class="button upload">
        Use your own file
        <input type="file" accept="audio/*,video/mp4,.wav,.mp3,.flac,.ogg,.m4a,.mp4" data-file />
      </label>
    </div>

    <div class="stage">
      <div class="track">
        <canvas class="wave" data-waveform></canvas>
        <div class="overlay" data-overlay></div>
      </div>
      <p class="status" data-status role="status">Loading the WebAssembly build…</p>
      <dl class="stats" data-stats></dl>
    </div>

    <div class="results">
      <div class="table-wrap">
        <table class="clips">
          <thead>
            <tr>{COLUMNS.map((column) => <th>{column}</th>)}</tr>
          </thead>
          <tbody data-rows></tbody>
        </table>
      </div>
      <div class="policy">
        <div class="policy-head">
          <span class="label">Thresholds</span>
          <button type="button" class="reset" data-reset>Reset</button>
        </div>
        <div data-policy></div>
        <p class="fine">Moving a slider re-applies <code>FilterPolicy</code> to the stored measurements. Nothing is decoded again.</p>
      </div>
    </div>
    <p class="fine foot">Drag any wav, mp3, flac, ogg or mp4 onto this panel, up to 15 minutes. Samples are LibriSpeech utterances (CC BY 4.0) with noise, clipping and a dial tone added.</p>
  </div>
</Section>

<style>
  .head { padding: 88px 48px 56px; }
  .head .label { margin-bottom: 16px; }
  .head .lede { margin-top: 12px; }

  .demo { --tone-idle: var(--line-strong); transition: background-color 0.3s var(--ease); }
  .demo:global(.is-dragging) { background: var(--accent-faint); }
  .toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 20px; padding: 16px 24px; border-bottom: 1px solid var(--line); }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chip { min-height: 36px; padding: 0 14px; border: 1px solid var(--line-strong); background: var(--surface); font-size: 14px; cursor: pointer; }
  .chip:hover { border-color: var(--ink); }
  .chip[aria-pressed="true"] { background: var(--ink); border-color: var(--ink); color: var(--surface); }
  .upload { position: relative; margin-left: auto; min-height: 36px; }
  .upload input { position: absolute; width: 1px; height: 1px; opacity: 0; }
  .upload:focus-within { outline: 2px solid var(--accent); outline-offset: 2px; }

  .stage { padding: 48px 24px 8px; border-bottom: 1px solid var(--line); }
  .track { position: relative; }
  .wave { width: 100%; height: 132px; }
  .overlay { position: absolute; inset: 0; }
  .status { min-height: 1.5em; margin-top: 12px; font-size: 14px; color: var(--muted); }
  .status:global(.is-error) { color: var(--tone-danger); }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); margin: 16px -24px 0; border-top: 1px solid var(--line); }
  .stats :global(div) { padding: 14px 24px; min-width: 0; }
  .stats :global(div + div) { border-left: 1px solid var(--line); }
  .stats :global(dt) { font: 500 11px/16px var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .stats :global(dd) { margin: 4px 0 0; font: 500 15px/1.3 var(--mono); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .results { display: grid; grid-template-columns: minmax(0, 1fr) 300px; }
  .table-wrap { overflow-x: auto; padding: 20px 24px; }
  .clips { width: 100%; border-collapse: collapse; font: 13px/1.4 var(--mono); }
  .clips th { padding: 0 10px 10px; text-align: right; font: 500 11px/1 var(--mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); border-bottom: 1px solid var(--line-strong); white-space: nowrap; }
  .clips th:nth-last-child(-n + 2) { text-align: left; }
  .clips :global(td) { padding: 9px 10px; text-align: right; border-bottom: 1px solid var(--line); white-space: nowrap; }
  .clips :global(tr:last-child td) { border-bottom: 0; }
  .clips :is(th, :global(td)):first-child { padding-left: 0; }
  .clips :global(.verdict) { color: var(--tone-color); font-weight: 500; text-align: left; }
  .clips :global(.detail) { text-align: left; color: var(--muted); }
  .clips :global(tbody tr) { cursor: pointer; transition: background-color 0.2s var(--ease); }
  .clips :global(tbody tr:hover),
  .clips :global(tbody tr:focus-visible),
  .clips :global(tbody tr.is-playing) { background: var(--accent-faint); outline: none; }

  .policy { padding: 20px 24px; border-left: 1px solid var(--line); }
  .policy-head { display: flex; justify-content: space-between; align-items: baseline; padding-bottom: 10px; border-bottom: 1px solid var(--line-strong); }
  .reset { padding: 0; border: 0; background: none; font: 500 12px var(--mono); letter-spacing: 0.08em; text-transform: uppercase; text-decoration: underline dashed; text-underline-offset: 5px; cursor: pointer; }
  .policy :global(.policy-row) { display: grid; grid-template-columns: 1fr auto; gap: 4px 8px; padding: 12px 0 4px; }
  .policy :global(.policy-label) { display: grid; font-size: 14px; }
  .policy :global(.policy-label code) { font-size: 11px; color: var(--muted); }
  .policy :global(.policy-row output) { font: 13px var(--mono); align-self: start; }
  .policy :global(.policy-row input) { grid-column: 1 / -1; width: 100%; accent-color: var(--accent); }
  .policy .fine { margin-top: 12px; }
  .foot { padding: 14px 24px; border-top: 1px solid var(--line); }

  @media (max-width: 900px) {
    .head { padding: 56px 20px 40px; }
    .toolbar, .table-wrap, .policy, .foot { padding-inline: 16px; }
    .stage { padding: 40px 16px 8px; }
    .stats { margin-inline: -16px; }
    .stats :global(div) { padding-inline: 16px; }
    .upload { margin-left: 0; }
    .results { grid-template-columns: 1fr; }
    .policy { border-left: 0; border-top: 1px solid var(--line); }
  }
</style>
