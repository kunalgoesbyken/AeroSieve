---
interface Props {
  name: "decode" | "segment" | "measure" | "reasons" | "stream";
}

const { name } = Astro.props;

const FORMATS = ["wav", "mp3", "flac", "ogg", "mp4"];
const SPEECH = [6, 18, 30, 22, 34, 14, 4, 2, 4, 20, 36, 28, 40, 18, 26, 8, 2, 3, 2, 12, 30, 38, 24, 32, 20, 10, 3, 2, 3, 6, 24, 34, 40, 30, 18, 26, 12, 4, 2, 3, 2, 16, 28, 36, 22, 30, 14, 6];
const METERS = [
  { label: "SNR", value: 0.72 },
  { label: "dBFS", value: 0.55 },
  { label: "clip", value: 0.12 },
  { label: "flat", value: 0.4 },
];
const REASONS = [
  { label: "accept", x: 24, y: 28, kept: true },
  { label: "low_snr", x: 128, y: 28 },
  { label: "clipping", x: 224, y: 28 },
  { label: "tonal", x: 24, y: 80 },
  { label: "too_quiet", x: 112, y: 80 },
  { label: "too_loud", x: 216, y: 80 },
  { label: "silence", x: 120, y: 132 },
];
const CHUNKS = [30, 54, 70, 98, 110, 140];
const STREAMS = ["M24 66 C 120 66, 140 90, 196 90", "M24 114 C 120 114, 140 90, 196 90"];

const formatWire = (index: number) => `M44 11 C 90 11, 100 ${74 - index * 30}, 140 ${74 - index * 30}`;
---

<div class="art" data-art aria-hidden="true">
  <svg viewBox="0 0 320 180" fill="none" stroke-linecap="round" stroke-linejoin="round">
    {name === "decode" && (
      <g>
        {FORMATS.map((label, index) => (
          <g transform={`translate(28 ${16 + index * 30})`} style={`--i: ${index}`}>
            <rect width="44" height="22" class="tile" />
            <text x="22" y="15" class="tile-text">{label}</text>
            <path d={formatWire(index)} class="wire" />
            <path d={formatWire(index)} class="flow" pathLength="100" />
          </g>
        ))}
        <rect x="140" y="66" width="44" height="44" class="core" />
        <path d="M152 88h4m4-8v16m4-12v8m4-14v20m4-10v0" class="core-mark" />
        <path d="M184 88h28" class="wire" />
        <path d="M212 88 l6 -10 l6 20 l6 -24 l6 28 l6 -18 l6 10 l6 -6 l6 4 l6 -4 l6 0" class="accent trace" pathLength="100" />
        <text x="250" y="124" class="caption">16 kHz mono</text>
      </g>
    )}
    {name === "segment" && (
      <g>
        <path d="M16 90h288" class="faint" />
        {SPEECH.map((height, index) => (
          <path d={`M${20 + index * 6} ${90 - height / 2}v${height}`} class={height > 5 ? "bar level" : "faint"} style={`--i: ${index}`} />
        ))}
        <path d="M26 46v-8h80v8M128 46v-8h70v8M200 46v-8h84v8" class="accent" />
        <path d="M20 52v76" class="playhead" />
        <text x="66" y="30" class="caption">clip 1</text>
        <text x="163" y="30" class="caption">clip 2</text>
        <text x="242" y="30" class="caption">clip 3</text>
        <text x="160" y="150" class="caption">pauses under 500 ms are bridged</text>
      </g>
    )}
    {name === "measure" && (
      <g>
        {METERS.map(({ label, value }, index) => (
          <g transform={`translate(${46 + index * 64} 24)`}>
            <rect width="28" height="120" class="tile" />
            <rect width="28" height="120" class="fill meter" style={`--v: ${value}; --i: ${index}`} />
            <path d="M-6 84h40" class="threshold" />
            <text x="14" y="140" class="caption">{label}</text>
          </g>
        ))}
      </g>
    )}
    {name === "reasons" && (
      <g>
        {REASONS.map(({ label, x, y, kept }, index) => (
          <g transform={`translate(${x} ${y})`}>
            <g class="chip" style={`--i: ${index}`}>
              <rect width={label.length * 8 + 28} height="26" class={kept ? "chip-keep" : "tile"} />
              <rect x="9" y="10" width="6" height="6" class={kept ? "dot-keep" : "dot-drop"} />
              <text x="22" y="17" class="chip-text">{label}</text>
            </g>
          </g>
        ))}
      </g>
    )}
    {name === "stream" && (
      <g>
        <text x="20" y="44" class="caption-left">live, any chunking</text>
        <text x="20" y="144" class="caption-left">batch, whole file</text>
        {CHUNKS.map((x, index) => <path d={`M${x} 60v12`} class="bar bob" style={`--i: ${index}`} />)}
        {STREAMS.map((d, index) => (
          <>
            <path d={d} class="wire" />
            <path d={d} class="flow" pathLength="100" style={`--i: ${index}`} />
          </>
        ))}
        <path d="M24 114h150" class="faint" />
        <rect x="196" y="72" width="36" height="36" class="core" />
        <path d="M206 90l6 6l10 -12" class="accent trace" pathLength="100" />
        <path d="M232 90h72" class="wire" />
        <path d="M232 90h72" class="flow is-out" pathLength="100" />
        <text x="268" y="80" class="caption">same verdict</text>
      </g>
    )}
  </svg>
</div>

<style>
  .art {
    height: 200px;
    display: grid;
    place-items: center;
    padding: 12px 20px;
    background-image: radial-gradient(var(--line-strong) 1px, transparent 1.2px);
    background-size: 16px 16px;
    background-position: 8px 8px;
    transition: background-color 0.4s var(--ease);
  }
  svg { width: 100%; height: 100%; max-width: 360px; }
  .tile { fill: var(--surface); stroke: var(--line-strong); }
  .tile-text, .chip-text { fill: var(--ink-soft); font: 500 10px var(--mono); }
  .tile-text { text-anchor: middle; }
  .wire { stroke: var(--accent); stroke-width: 1.2; opacity: 0.55; }
  .accent { stroke: var(--accent); stroke-width: 2; }
  .core { fill: var(--accent-faint); stroke: var(--accent); stroke-width: 1.5; }
  .core-mark { stroke: var(--accent); stroke-width: 2; }
  .bar { stroke: var(--accent); stroke-width: 3; }
  .faint { stroke: var(--line-strong); stroke-width: 1.5; }
  .fill { fill: var(--accent-soft); stroke: var(--accent); }
  .threshold { stroke: var(--ink); stroke-dasharray: 3 3; }
  .caption { fill: var(--muted); font: 10px var(--mono); text-anchor: middle; }
  .caption-left { fill: var(--muted); font: 10px var(--mono); }
  .chip-keep { fill: var(--accent-faint); stroke: var(--accent); }
  .dot-keep { fill: var(--accent); }
  .dot-drop { fill: var(--ink-soft); }

  .flow { stroke: var(--accent); stroke-width: 2.5; stroke-dasharray: 14 100; stroke-dashoffset: 14; opacity: 0; }
  .playhead { stroke: var(--ink); stroke-width: 1; opacity: 0; }
  .core, .level, .meter, .chip, .bob { transform-box: fill-box; transform-origin: center; }
  .meter { transform-origin: bottom; transform: scaleY(var(--v)); }

  .art:global(.is-playing) .flow { animation: flow 2.8s cubic-bezier(0.6, 0.1, 0.35, 1) calc(var(--i, 0) * 0.22s) infinite; }
  .art:global(.is-playing) .flow.is-out { animation-delay: 1.3s; }
  .art:global(.is-playing) .core { animation: pulse 2.8s ease-in-out 1.1s infinite; }
  .art:global(.is-playing) .trace { stroke-dasharray: 100; animation: trace 2.8s ease-in-out 1.2s infinite both; }
  .art:global(.is-playing) .level { animation: level 1.8s ease-in-out calc(var(--i) * -0.11s) infinite; }
  .art:global(.is-playing) .playhead { animation: sweep 4.8s linear infinite; }
  .art:global(.is-playing) .meter { animation: meter 3.6s ease-in-out calc(var(--i) * -0.9s) infinite; }
  .art:global(.is-playing) .chip { animation: spotlight 7s ease-in-out calc(var(--i) * 1s) infinite; }
  .art:global(.is-playing) .bob { animation: bob 1.6s ease-in-out calc(var(--i) * -0.27s) infinite; }

  @keyframes flow {
    0% { stroke-dashoffset: 14; opacity: 1; }
    55% { stroke-dashoffset: -100; opacity: 1; }
    56%, 100% { stroke-dashoffset: -100; opacity: 0; }
  }
  @keyframes pulse {
    0%, 30%, 100% { transform: scale(1); }
    12% { transform: scale(1.08); }
  }
  @keyframes trace {
    0% { stroke-dashoffset: 100; }
    35%, 85% { stroke-dashoffset: 0; }
    100% { stroke-dashoffset: -100; }
  }
  @keyframes level {
    0%, 100% { transform: scaleY(1); }
    50% { transform: scaleY(0.55); }
  }
  @keyframes sweep {
    0% { transform: translateX(0); opacity: 0; }
    4%, 94% { opacity: 1; }
    100% { transform: translateX(278px); opacity: 0; }
  }
  @keyframes meter {
    0%, 100% { transform: scaleY(var(--v)); }
    50% { transform: scaleY(calc(var(--v) * 0.55 + 0.2)); }
  }
  @keyframes spotlight {
    0%, 14%, 100% { transform: none; }
    5%, 9% { transform: translateY(-3px); }
  }
  @keyframes bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-3px); }
  }
</style>
