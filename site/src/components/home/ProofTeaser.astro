---
import Section from "../Section.astro";

const NUMBERS = [
  { value: "+8.9 pts", text: "higher Whisper error rate on the clips it rejects, on 2,917 real Hindi phone recordings" },
  { value: "24,385", text: "of 24,409 injected defects caught across six languages, with the right reason named for all but 2" },
  { value: "940×", text: "faster than real time: 43 minutes of 48 kHz audio curated in 2.75 s on a laptop CPU" },
];
---

<Section tone="sunken">
  <div class="head">
    <p class="label">Proof</p>
    <h2 class="title">Checked against real recognizers, not just its own benchmark</h2>
    <p class="lede">The same tests found three bugs in AeroSieve, and showed which checks do not help. All of it is on the proof page.</p>
  </div>
</Section>

<Section tone="surface" cross>
  <div class="numbers">
    {NUMBERS.map(({ value, text }) => (
      <div class="number">
        <p class="metric">{value}</p>
        <p class="text">{text}</p>
      </div>
    ))}
    <div class="more">
      <a class="text-link" href="/proof">See all the evidence <span class="arrow">→</span></a>
    </div>
  </div>
</Section>

<style>
  .head { padding: 88px 48px 56px; }
  .head .label { margin-bottom: 16px; }
  .head .lede { margin-top: 12px; }
  .numbers { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .number { padding: 40px 48px; }
  .number + .number { border-left: 1px solid var(--line); }
  .text { margin-top: 14px; font-size: 15px; color: var(--muted); max-width: 32ch; }
  .more { grid-column: 1 / -1; padding: 20px 48px; border-top: 1px solid var(--line); }
  @media (max-width: 900px) {
    .head { padding: 56px 20px 40px; }
    .numbers { grid-template-columns: 1fr; }
    .number { padding: 28px 20px; }
    .number + .number { border-left: 0; border-top: 1px solid var(--line); }
    .more { padding: 20px; }
  }
</style>
