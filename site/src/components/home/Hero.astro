---
import "../../styles/verdicts.css";
import { INSTALL } from "../../data/site.js";
import HeroFrame from "../HeroFrame.astro";
import { describe, isKept } from "../../scripts/verdicts.js";
import hero from "../../../public/data/hero.json";

const pills = hero.clips.map((clip, order) => ({ clip, order, ...describe(clip) }));
const kept = pills.filter(({ clip }) => isKept(clip));
const groups = [
  { title: "Kept", items: kept },
  { title: "Dropped", items: pills.filter(({ clip }) => !isKept(clip)) },
];
const waveform = { envelope: hero.envelope, durationS: hero.duration_s, clips: hero.clips };
---

<HeroFrame>
  <div class="split">
    <div class="hero-copy">
      <div>
        <h1 class="display">
          AeroSieve turns raw recordings into <strong>clean training data</strong> for speech models.
        </h1>
        <p class="hero-sub">Every clip it drops comes with a named reason. It runs on the CPU with no ML model by default, from the command line, Rust, Python, a WebSocket server or this page.</p>
        <div class="hero-actions">
          <button class="command" type="button" data-copy={INSTALL}>
            <span class="prompt">$</span>{INSTALL}<span class="copy label">Copy</span><span class="copied label">Copied</span>
          </button>
          <a class="button" href="#demo">Try the live demo</a>
        </div>
      </div>
      <p class="fine">Open source, MIT licensed. Tested on real Hindi phone speech and six benchmark languages.</p>
    </div>

    <figure class="sample" data-hero={JSON.stringify(waveform)}>
      <div class="sample-head">
        <span class="label">Sample</span>
        <span class="sample-file">{hero.sample}</span>
        <span class="sample-length label">{hero.duration_s.toFixed(1)} s · {hero.sample_rate / 1000} kHz</span>
      </div>
      <div class="sample-body">
        <div class="sample-track">
          <canvas class="sample-wave" data-hero-waveform></canvas>
          <span class="sample-scan" data-hero-scan aria-hidden="true"></span>
        </div>
        {groups.map(({ title, items }) => (
          <>
            <p class="label">{title}</p>
            <ul class="pills">
              {items.map(({ clip, order, label, tone, detail }) => (
                <li class={`pill tone-${tone}`} style={`--order: ${order}`} data-clip={order}>
                  <span class="pill-time">{clip.start_s.toFixed(1)}s</span>
                  <span class="pill-label">{label}</span>
                  <span class="pill-detail">{detail}</span>
                </li>
              ))}
            </ul>
          </>
        ))}
      </div>
      <figcaption class="sample-foot">
        <span>{kept.length} of {hero.clips.length} clips kept · decoded and scored by the WebAssembly build</span>
        <a class="text-link" href="#demo">Your own file <span class="arrow">↓</span></a>
      </figcaption>
    </figure>
  </div>
</HeroFrame>

<style>
  .split { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); }
  .hero-copy {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 48px;
    padding: 40px 32px 32px;
  }
  .hero-sub { margin-top: 24px; max-width: 46ch; font-size: 17px; color: var(--muted); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 32px; }
  .hero-actions .label { color: var(--muted); }

  .sample { display: flex; flex-direction: column; border-left: 1px solid var(--line); background: var(--surface); --tone-idle: var(--line-strong); }
  .sample-head { display: flex; align-items: center; gap: 20px; padding: 16px 20px; border-bottom: 1px solid var(--line); }
  .sample-file { font-size: 17px; }
  .sample-length { margin-left: auto; }
  .sample-body { flex: 1; padding: 24px 20px; }
  .sample-track { position: relative; margin-bottom: 24px; overflow: hidden; }
  .sample-wave { display: block; width: 100%; height: 112px; }
  .sample-scan { position: absolute; inset: 0; pointer-events: none; will-change: transform; animation: scan 9s linear infinite; }
  .sample-scan::before { content: ""; position: absolute; inset: 0 auto 0 0; width: 1px; background: var(--ink); }
  @keyframes scan { to { transform: translateX(100%); } }
  @media (prefers-reduced-motion: reduce) { .sample-scan { display: none; } }
  .sample-body .label { margin: 16px 0 8px; }
  .pills { display: flex; flex-wrap: wrap; gap: 6px; padding: 0; list-style: none; min-height: 26px; }
  .sample-foot { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 14px 20px; border-top: 1px solid var(--line); font: 12px/1.4 var(--mono); color: var(--muted); }

  @media (max-width: 900px) {
    .split { grid-template-columns: 1fr; }
    .sample { border-left: 0; border-top: 1px solid var(--line); }
    .hero-copy { padding: 28px 20px; }
  }
</style>
