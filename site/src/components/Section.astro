---
import Dither from "./Dither.astro";

interface Props {
  id?: string;
  tone?: "canvas" | "surface" | "sunken" | "dither";
  cross?: boolean;
}

const { id, tone = "canvas", cross = false } = Astro.props;
const dither = tone === "dither";
---

<section id={id} class:list={["band", `tone-${tone}`, { dither }]}>
  {dither && <Dither />}
  <div class="frame band-inner">
    {cross && (
      <>
        <span class="mark start" aria-hidden="true"></span>
        <span class="mark end" aria-hidden="true"></span>
      </>
    )}
    <slot />
  </div>
</section>

<style>
  .band { position: relative; isolation: isolate; border-top: 1px solid var(--line); overflow-x: clip; }
  .tone-canvas { background: var(--canvas); }
  .tone-surface { background: var(--surface); }
  .tone-sunken { background: var(--sunken); }
  .band-inner { position: relative; }
  .mark { top: -11px; z-index: 1; }
  .start { left: -11px; }
  .end { right: -11px; }
</style>
