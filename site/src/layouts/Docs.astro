---
import "../styles/prose.css";
import Base from "./Base.astro";
import { LINKS } from "../data/site.js";
import { DOCS, GROUPS, LINK_LABELS, docFromPath, docHref } from "../data/docs.js";

interface Props {
  headings?: { depth: number; slug: string; text: string }[];
}

const { headings = [] } = Astro.props;
const doc = docFromPath(Astro.url.pathname);
if (!doc) throw new Error(`${Astro.url.pathname} is not listed in src/data/docs.js`);

const position = DOCS.indexOf(doc);
const previous = DOCS[position - 1];
const next = DOCS[position + 1];
const outline = headings.filter(({ depth }) => depth === 2 || depth === 3);
const title = doc.slug === "index" ? "AeroSieve documentation" : `${doc.title} | AeroSieve docs`;
---

<Base title={title} description={doc.description}>
  <div class="docs frame">
    <div class="side-col">
      <nav class="side" aria-label="Documentation">
        {GROUPS.map((group) => (
          <div class="group">
            <p class="label">{group}</p>
            <ul>
              {DOCS.filter((entry) => entry.group === group).map((entry) => (
                <li>
                  <a href={docHref(entry.slug)} aria-current={entry === doc ? "page" : undefined}>{entry.title}</a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>

    <article class="page">
      <header class="head">
        <p class="label">{doc.group}</p>
        <h1 class="title">{doc.title}</h1>
        <p class="lede">{doc.description}</p>
        <ul class="refs">
          {doc.links.map((key) => (
            <li><a class="text-link" href={LINKS[key]}>{LINK_LABELS[key]} <span class="arrow" aria-hidden="true">&nearr;</span></a></li>
          ))}
        </ul>
      </header>

      <div class="prose" data-code-copy>
        <slot />
      </div>

      <nav class="pager" aria-label="Pages">
        {previous ? (
          <a class="prev" href={docHref(previous.slug)}>
            <span class="label">Previous</span>
            <span class="name">&larr; {previous.title}</span>
          </a>
        ) : <span></span>}
        {next ? (
          <a class="next" href={docHref(next.slug)}>
            <span class="label">Next</span>
            <span class="name">{next.title} &rarr;</span>
          </a>
        ) : <span></span>}
      </nav>
    </article>

    <div class="toc-col">
      {outline.length > 1 && (
        <nav class="toc" aria-label="On this page">
          <p class="label">On this page</p>
          <ul>
            {outline.map(({ depth, slug, text }) => (
              <li class:list={{ deep: depth === 3 }}><a href={`#${slug}`}>{text}</a></li>
            ))}
          </ul>
        </nav>
      )}
    </div>
  </div>
</Base>

<style>
  .docs {
    display: grid;
    grid-template-columns: 248px minmax(0, 1fr) 232px;
    min-height: calc(100vh - 72px);
  }

  .side-col { border-right: 1px solid var(--line); }
  .toc-col { border-left: 1px solid var(--line); }

  .side, .toc {
    position: sticky;
    top: 72px;
    max-height: calc(100vh - 72px);
    overflow-y: auto;
    padding: 32px 0;
  }

  .group + .group { margin-top: 28px; }
  .side .label, .toc .label { padding-inline: 24px; margin-bottom: 8px; }
  .side ul, .toc ul { padding: 0; list-style: none; }

  .side a {
    display: block;
    padding: 7px 24px;
    border-left: 2px solid transparent;
    font-size: 15px;
    color: var(--ink-soft);
    text-decoration: none;
  }
  .side a:hover { color: var(--ink); background: var(--sunken); }
  .side a[aria-current="page"] {
    color: var(--ink);
    background: var(--accent-faint);
    border-left-color: var(--accent);
  }

  .toc a {
    display: block;
    padding: 5px 24px;
    font-size: 14px;
    line-height: 20px;
    color: var(--muted);
    text-decoration: none;
  }
  .toc a:hover { color: var(--ink); }
  .toc .deep a { padding-left: 40px; }

  .page {
    min-width: 0;
    background: var(--surface);
    padding: 48px clamp(20px, 4vw, 48px) 0;
  }

  .head { padding-bottom: 32px; border-bottom: 1px solid var(--line); }
  .head .title { margin-top: 12px; }
  .head .lede { margin-top: 12px; }
  .refs { display: flex; flex-wrap: wrap; gap: 8px 24px; margin-top: 20px; padding: 0; list-style: none; }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-inline: calc(-1 * clamp(20px, 4vw, 48px));
    border-top: 1px solid var(--line);
  }
  .pager a {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 24px clamp(20px, 4vw, 48px);
    text-decoration: none;
  }
  .pager a:hover { background: var(--accent-faint); }
  .pager .next { grid-column: 2; align-items: flex-end; text-align: right; border-left: 1px solid var(--line); }
  .pager .name { font-size: 17px; }

  @media (max-width: 1199px) {
    .docs { grid-template-columns: 232px minmax(0, 1fr); }
    .toc-col { display: none; }
  }

  @media (max-width: 899px) {
    :global(html) { scroll-padding-top: 140px; }
    .docs { display: block; min-height: 0; }
    .side-col {
      position: sticky;
      top: 72px;
      z-index: 10;
      border-right: 0;
      border-bottom: 1px solid var(--line);
      background: var(--surface);
    }
    .side {
      position: static;
      display: flex;
      max-height: none;
      overflow-x: auto;
      padding: 0;
    }
    .group { display: contents; }
    .side .label { display: none; }
    .side ul { display: flex; }
    .side a {
      padding: 14px 16px;
      border-left: 0;
      border-bottom: 2px solid transparent;
      white-space: nowrap;
    }
    .side a[aria-current="page"] { border-bottom-color: var(--accent); }
    .page { padding-top: 32px; }
  }
</style>
